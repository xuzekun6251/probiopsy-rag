# Required keys for 前列安汇.
# Copy this file to `.env` and fill in real values.
# Get keys from the providers' official sites.
#
# TWO-TIER LLM + EMBEDDING STACK (PLAN.md §13 risk #6 mitigation):
#   - Bulk LLM (cheap):    DeepSeek V4 Flash for all A×B pairs (rule-engine + retrieval + bulk LLM screening)
#   - Arbiter LLM (premium): GPT-4/5 via relay station for high-risk pairs only (~10% of cases)
#   - Embedding:           Doubao-embedding-vision-251215 via /v3/embeddings/multimodal endpoint for LightRAG vector index
# All three are REQUIRED because phase4_build_index.py builds the real LightRAG index (v2.6).

# ===== BULK LLM: DeepSeek (主力 chat + LightRAG entity extraction, 国内直连) =====
# Apply: https://platform.deepseek.com/api_keys
HUANYU_BULK_PROVIDER=openai
HUANYU_BULK_MODEL=glm-5.3
HUANYU_BULK_API_KEY=
HUANYU_BULK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
HUANYU_BULK_TEMPERATURE=0.0
HUANYU_BULK_MAX_TOKENS=4096
# Backward-compat aliases (also read by older scripts)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_CHAT_MODEL=glm-5.3

# ===== ARBITER LLM: GPT-4/5 via relay station (高端仲裁, 仅高风险对) =====
# Relay stations are OpenAI-compatible proxies that allow mainland China access without VPN.
# Common relay stations:
#   - codexauv (https://www.codexauv.com)
#   - api2d (https://api2d.com, key prefix "fk-")
#   - chatanywhere (https://api.chatanywhere.com.cn, free 7$ trial)
#   - oneapi (self-hosted, https://github.com/songquanpeng/one-api)
# Pick one, register, and fill in HUANYU_ARBITER_BASE_URL + HUANYU_ARBITER_API_KEY below.
HUANYU_ARBITER_PROVIDER=openai
HUANYU_ARBITER_MODEL=gpt-4o
HUANYU_ARBITER_API_KEY=
HUANYU_ARBITER_BASE_URL=
HUANYU_ARBITER_TEMPERATURE=0.0
HUANYU_ARBITER_MAX_TOKENS=2048

# ===== Embedding: 火山方舟 Doubao-embedding-vision-251215 (required for LightRAG real mode) =====
# Apply: https://www.volcengine.com/product/ark
# (v2.6) CORRECT multimodal embedding call shape (earlier docs said `content`, wrong):
#   POST https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
#   Authorization: Bearer $HUANYU_EMBED_API_KEY
#   {"model":"<endpoint_id or model_name>","input":[{"type":"text","text":"..."}],"encoding_format":"float"}
#   → {"data":{"embedding":[...]}}   (single object, dim=2048)
# The endpoint accepts ONLY ONE input per call (no batch); ArkVisionEmbedding
# fans out concurrently. Pure short Chinese text sometimes returns HTTP 500
# InternalServiceError — the client auto-prepends "[text] " and retries once.
# Endpoint ID is obtained by creating an 接入点 at:
#   https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
HUANYU_EMBED_PROVIDER=openai
HUANYU_EMBED_MODEL=doubao-embedding-vision-251215
HUANYU_EMBED_ENDPOINT_ID=<your-endpoint-id-ep-xxxxxxxx>
HUANYU_EMBED_API_KEY=
HUANYU_EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
HUANYU_EMBED_DIM=2048
HUANYU_EMBED_CONCURRENCY=8
# Backward-compat
ARK_DOUBAO_API_KEY=
ARK_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_CHAT_MODEL_DOUBAO=doubao-pro-32k
LLM_EMBED_MODEL=doubao-embedding-vision-251215

# ===== Backward-compat single-provider vars (used if BULK_*/ARBITER_* are unset) =====
HUANYU_LLM_PROVIDER=stub
HUANYU_LLM_MODEL=stub
HUANYU_LLM_API_KEY=
HUANYU_LLM_BASE_URL=

# ===== Optional: foreign providers direct (need proxy in mainland China) =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===== NCBI E-utilities (free, rate-limited without key) =====
NCBI_API_KEY=

# ===== HuggingFace mirror (China-accessible; auto-set by setup_environment.py) =====
HF_ENDPOINT=https://hf-mirror.com
HF_TOKEN=
